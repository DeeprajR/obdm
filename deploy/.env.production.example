# The production deployment: obdm.deeprajr.com and its four staff hosts.
#
# Copy to deploy/.env.production and fill in. Read by docker compose; every
# value reaches a container through its environment and nothing is written to
# a file inside one. This file must never be committed: deploy/.env* is in
# .gitignore and .dockerignore. The development deployment has its own file,
# .env.development.example, with the dev-obdm hosts.
#
# Each application refuses to start in production while any of these is
# missing or still a development default (packages/config/src/runtime-env.ts).

ENVIRONMENT=production

# ---------------------------------------------------------------------------
# Images, from the release workflow (.github/workflows/release.yml). Production
# runs a tagged release, never `latest`.
# ---------------------------------------------------------------------------
IMAGE_PREFIX=ghcr.io/deeprajr/obdm
IMAGE_TAG=v1.0.0
# Shown on the control panel's deployment screen. The commit or tag deployed.
BUILD_ID=

# ---------------------------------------------------------------------------
# Hosts. One level under deeprajr.com, because Cloudflare's free certificate
# covers *.deeprajr.com and nothing deeper: `doctor.obdm.deeprajr.com` would
# fail TLS at the edge. Behind the tunnel each is a public hostname on the
# tunnel; behind Caddy, a DNS record to this machine and a certificate for
# each, and the applications build every cross-application link from them
# (§13). The donor application is the public face and takes the bare name.
# ---------------------------------------------------------------------------
DONOR_HOST=obdm.deeprajr.com
DOCTOR_HOST=doctor-obdm.deeprajr.com
ADMIN_HOST=admin-obdm.deeprajr.com
CENTRE_HOST=centre-obdm.deeprajr.com
VOLUNTEER_HOST=volunteer-obdm.deeprajr.com

# Only with `--profile tunnel`: the token from Zero Trust → Networks →
# Tunnels → your tunnel → the docker command (the part after --token).
TUNNEL_TOKEN=

# Only with `--profile tunnel`: the header Cloudflare sets to the visitor's
# address, which the sign-in and chat throttles key on. Leave it empty behind
# Caddy, where a client could write it themselves.
CLIENT_IP_HEADER=cf-connecting-ip

# Demo mode, optional. The email of an active account of that application's
# role; its sign-in page then leads with an "Enter the demo" button that opens
# that account with no password, for anyone with the link. Leave empty to
# turn it off (then `up -d`). The account is shared by every visitor: give it
# made-up data only. There is no admin equivalent.
DEMO_DOCTOR_EMAIL=
DEMO_CENTRE_EMAIL=
DEMO_VOLUNTEER_EMAIL=

# ---------------------------------------------------------------------------
# Database: three roles, three URLs, not interchangeable (§5.1).
#
# The prototype runs Postgres on this machine (`--profile local-db`), and the
# URLs point at the `postgres` container; each password here must match the
# one below. A managed PostgreSQL 16 instead: its host, and ?sslmode=require
# on all three.
# ---------------------------------------------------------------------------
MIGRATION_DATABASE_URL=postgres://migrator:CHANGE-ME@postgres:5432/obdm
DATABASE_URL=postgres://app_web:CHANGE-ME@postgres:5432/obdm
BOT_DATABASE_URL=postgres://app_bot:CHANGE-ME@postgres:5432/obdm

# Only with `--profile local-db`: the passwords the roles are created with.
# Generate each with `openssl rand -hex 24`; hex, so nothing needs escaping in
# a URL.
POSTGRES_SUPERUSER_PASSWORD=
MIGRATOR_PASSWORD=
APP_WEB_PASSWORD=
APP_BOT_PASSWORD=

# ---------------------------------------------------------------------------
# Object storage: a private bucket, credentials scoped to it (§3, §4).
#
# Cloudflare R2: the endpoint carries your account id (R2 → Overview), the
# region is `auto`, and the key is an R2 API token with Object Read & Write on
# this bucket only. Leave public access off. AWS S3 instead:
# https://s3.ap-south-1.amazonaws.com, ap-south-1, and path style false.
# ---------------------------------------------------------------------------
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=obdm-prod
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Email: a transactional provider over SMTP, on a verified sending domain
# with SPF, DKIM and DMARC published (§2.4).
#
# Brevo: Settings → SMTP & API → SMTP. The user is the SMTP login it shows
# (not your account email), the password an SMTP key generated there.
# obdm-mail.deeprajr.com must be authenticated under Senders, Domains &
# Dedicated IPs. A subdomain of its own keeps OBDM's sending reputation apart
# from deeprajr.com's own mail.
# Not obdm.deeprajr.com: that name is the tunnel's CNAME, and DNS allows no
# other record beside a CNAME, so the TXT records Brevo verifies with could
# not be added there.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# true only for implicit TLS on 465; STARTTLS on 587 is negotiated with false.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="OBDM <no-reply@obdm-mail.deeprajr.com>"

# ---------------------------------------------------------------------------
# The donor application (ADR 0017)
# ---------------------------------------------------------------------------
BOT_TICK_INTERVAL_MS=15000
# The conversation log: one line per message, phone numbers masked. Off in
# production; turn it on briefly to diagnose, and off again.
BOT_LOG=off

# ---------------------------------------------------------------------------
# The centre's own place in the seeded hierarchy, for the bootstrap
# ---------------------------------------------------------------------------
CENTRE_DISTRICT_ID=KL_KKD
CENTRE_CITY_ID=KKD_T1
