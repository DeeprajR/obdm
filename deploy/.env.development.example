# The development deployment: dev-obdm.deeprajr.com and its four staff hosts.
#
# Copy to deploy/.env.development and fill in. Same shape as
# .env.production.example; the differences are the hostnames, the image tag
# (every push to main, not a release), and that this database is **seeded**
# with the synthetic demonstration records rather than bootstrapped with one
# administrator. Nothing real runs here, ever: the seeded accounts carry a
# published password, and a database that has held them is never promoted.
#
# The file must never be committed: deploy/.env* is in .gitignore and
# .dockerignore.

ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Images: the latest build of main (.github/workflows/release.yml)
# ---------------------------------------------------------------------------
IMAGE_PREFIX=ghcr.io/deeprajr/obdm
IMAGE_TAG=latest
BUILD_ID=

# ---------------------------------------------------------------------------
# Hosts. One level under deeprajr.com, because Cloudflare's free certificate
# covers *.deeprajr.com and nothing deeper: `doctor.obdm.deeprajr.com` would
# fail TLS at the edge. Behind the tunnel each is a public hostname on the
# tunnel; behind Caddy, a DNS record to this machine and a certificate for
# each. The donor application is the public face and takes the bare name.
# ---------------------------------------------------------------------------
DONOR_HOST=dev-obdm.deeprajr.com
DOCTOR_HOST=doctor-dev-obdm.deeprajr.com
ADMIN_HOST=admin-dev-obdm.deeprajr.com
CENTRE_HOST=centre-dev-obdm.deeprajr.com
VOLUNTEER_HOST=volunteer-dev-obdm.deeprajr.com

# Only with `--profile tunnel`. Its own tunnel, not production's.
TUNNEL_TOKEN=

# ---------------------------------------------------------------------------
# Database. Its own database, never production's. The local-db profile is
# the honest choice here; back it up only if you would miss the test data.
# ---------------------------------------------------------------------------
MIGRATION_DATABASE_URL=postgres://migrator:CHANGE-ME@postgres:5432/obdm
DATABASE_URL=postgres://app_web:CHANGE-ME@postgres:5432/obdm
BOT_DATABASE_URL=postgres://app_bot:CHANGE-ME@postgres:5432/obdm

POSTGRES_SUPERUSER_PASSWORD=
MIGRATOR_PASSWORD=
APP_WEB_PASSWORD=
APP_BOT_PASSWORD=

# ---------------------------------------------------------------------------
# Object storage: a separate bucket from production
# ---------------------------------------------------------------------------
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=obdm-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Email. A provider's sandbox, or a catcher, is right for this environment:
# nobody here needs a real invite. Mailpit as a container works (see the
# compose file's `mailpit` profile), with SMTP_HOST=mailpit and SMTP_PORT=1025
# refused by the boot check, so use 2525 on the container, as that profile does.
# ---------------------------------------------------------------------------
SMTP_HOST=mailpit
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="OBDM dev <no-reply@dev-obdm.deeprajr.com>"

# ---------------------------------------------------------------------------
# The donor application (ADR 0017). A faster tick makes testing less patient.
# ---------------------------------------------------------------------------
BOT_TICK_INTERVAL_MS=5000
BOT_LOG=on

CENTRE_DISTRICT_ID=KL_KKD
CENTRE_CITY_ID=KKD_T1
