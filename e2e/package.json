{
  "name": "@obdm/e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test --project=staff --project=journey --project=donor",
    "test:headed": "playwright test --project=staff --project=journey --project=donor --headed",
    "test:journey": "playwright test --project=journey",
    "journey:headed": "playwright test --project=journey --headed",
    "showcase": "playwright test --project=showcase --headed --reporter=line",
    "report": "playwright show-report",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@playwright/test": "^1.63.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^26.6.2"
  }
}
