# Copy to .env. Everything here points at the local Docker stack (`pnpm services:up`);
# nothing in this file is a secret, and nothing real ever runs against it.
#
# A deployment does not use this file. It sets the same variables in each
# container's environment (docs/deployment.md, deploy/.env.production.example),
# and every application refuses to start in production while any of them is
# missing or still one of the development values below.

# ---------------------------------------------------------------------------
# Database — three roles, three URLs, deliberately not interchangeable (§5.1)
# ---------------------------------------------------------------------------
# Applies migrations and runs seeds. Holds DDL rights that neither application
# role has (§5.9).
MIGRATION_DATABASE_URL=postgres://migrator:migrator@localhost:5433/obdm
# The web apps and the worker: hospital + reference, and nothing in bot.
DATABASE_URL=postgres://app_web:app_web@localhost:5433/obdm
# The bot: its own schema, reference read-only, and only the contract columns of
# hospital.donor_demand.
BOT_DATABASE_URL=postgres://app_bot:app_bot@localhost:5433/obdm
# The suite truncates every table between tests, so it gets its own database and
# the harness refuses any URL that is not named for testing.
TEST_DATABASE_URL=postgres://migrator:migrator@localhost:5433/obdm_test

# ---------------------------------------------------------------------------
# The donor bot (§2.11, ADR 0017)
# ---------------------------------------------------------------------------
# The bot is the donor application on :3004, a web chat on the app_bot role
# above. It runs its recruitment ticker in-process and needs no chat-platform
# token: nothing leaves this machine, which is the mode §10 asks for.
# A request link is <donor app origin>/r/<request id>.

# How often the ticker polls for work it is due. Everything it does is
# idempotent, so this is a latency choice rather than a correctness one.
BOT_TICK_INTERVAL_MS=15000

# One line per message received and sent on the donor app's terminal, phone
# numbers masked. BOT_LOG=off silences it.
BOT_LOG=on

# ---------------------------------------------------------------------------
# Email — Mailpit, the local catcher. Inbox at http://localhost:8025
# ---------------------------------------------------------------------------
# A real provider sets SMTP_USER and SMTP_PASSWORD as well; Mailpit wants
# neither. SMTP_SECURE=true is implicit TLS on 465; STARTTLS on 587 is false.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM="OBDM <no-reply@obdm.local>"

# ---------------------------------------------------------------------------
# Object storage, S3Mock. Private bucket; objects are only ever served through
# an authenticated route (§3, §4). S3Mock checks no credentials, so these two
# are placeholders; `curl http://localhost:9090/obdm` lists the bucket.
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9090
S3_REGION=ap-south-1
S3_BUCKET=obdm
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local-dev-only
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Application. NODE_ENV is set by the tooling, never here — a value in .env
# makes `next build` produce a development bundle.
#
# The application timezone is a constant (packages/domain/src/time.ts), and
# sessions are random tokens stored hashed rather than signed, so there is no
# timezone or signing secret to set here.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# The four staff applications (§1, ADR 0016). Each role signs in to its own
# deployment, so anything crossing between them is an absolute link: the invite
# email opens in the doctor app, an address-change link in the account's own
# app, and the control panel links alerts into the centre app. The donor app
# (:3004, ADR 0017) has no sign-in and nothing links into it from here; its
# request links are shared from posters and messages.
# ---------------------------------------------------------------------------
DOCTOR_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001
CENTRE_APP_URL=http://localhost:3002
VOLUNTEER_APP_URL=http://localhost:3003
